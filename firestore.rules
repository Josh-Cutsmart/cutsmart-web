rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isCompanyMember(companyId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/companies/$(companyId)/memberships/$(request.auth.uid));
    }

    function canEditCompany(companyId) {
      return isCompanyMember(companyId);
    }

    // Who owns the company and who can do what in it, its join codes and its integrations' secrets: the app can read these but
    // not change them, or any member could make themselves owner. Only what actually changes counts, so a save that sends one
    // of these unchanged is fine. Changed on the server, which checks who's asking: app/api/company/member-role,
    // app/api/company/protected-settings, app/api/company/join-codes. Fixed once the company's created, the rest.
    function protectedCompanyFields() {
      return [
        'id', 'ownerUid', 'ownerId', 'createdAt', 'createdAtIso',
        'companyCode', 'companyPassword', 'joinCode', 'joinPassword',
        'staffRoleIdsByUid', 'roles', 'integrations'
      ];
    }

    function changesProtectedCompanyFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedCompanyFields());
    }

    function onlyUserColorFieldsOnCreate() {
      return request.resource.data.keys().hasOnly([
        'userColor', 'updatedAt', 'updatedAtIso'
      ]);
    }

    // Your own membership: only what you set about yourself — your name, mobile, badge colour and which What's New
    // you've seen. Never your role, permissions or email: the server reads those to decide what you can do.
    // affectedKeys, not changedKeys: changedKeys misses fields that are added or removed, which let a member add
    // permissions to their own membership, or remove their role and add it back as "owner".
    function onlyOwnMembershipFieldsOnUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'displayName', 'mobile', 'userColor', 'badgeColor', 'updateNoticeSeenVersions', 'updatedAt', 'updatedAtIso'
      ]);
    }

    function hasAuthEmail() {
      return signedIn() && request.auth.token.email is string;
    }

    function authEmailLower() {
      return hasAuthEmail() ? request.auth.token.email.lower() : "";
    }

    function isInviteEmailMatch() {
      return hasAuthEmail() && (
        (resource.data.email is string && resource.data.email.lower() == authEmailLower()) ||
        (resource.data.emailLower is string && resource.data.emailLower.lower() == authEmailLower())
      );
    }

    // Join codes: server only (lib/company-join-codes-server.ts, lib/company-create-server.ts). Each document's
    // id is a code, so reading them would hand anyone every company's code, and writing them would let
    // someone point a company's code at their own.
    match /companyJoinCodes/{codeKey} {
      allow read, write: if false;
    }

    // Global rule to allow collectionGroup("invites") lookups for signed-in users
    match /{path=**}/invites/{inviteId} {
      allow read: if signedIn();
    }

    // App-wide reports (Report Issue / Suggest Feature)
    match /appReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.auth.token.email is string
        && request.resource.data.reporterEmail is string
        && request.resource.data.reporterEmail.lower() == request.auth.token.email.lower()
        && request.resource.data.subject is string
        && request.resource.data.body is string
        && request.resource.data.kind is string
        && (request.resource.data.kind == "issue" || request.resource.data.kind == "feature");

      allow read: if signedIn();

      // Allow toggling Fixed/Complete only (plus update timestamps)
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'completed', 'completedAt', 'completedAtIso', 'updatedAt', 'updatedAtIso'
        ]);

      allow delete: if false;
    }

    // Per-project changelog entries (Settings > Changelog card on a project). Entries only carry
    // `projectId`, not `companyId`, so there's no cheap way to scope this to "same company" the
    // way isCompanyMember() does elsewhere — matches the trust level already used for the legacy
    // top-level /projects fallback and /appReports above (any signed-in user).
    match /changelog/{entryId} {
      allow read, write: if signedIn();
    }

    // Fields of users/{uid} only server code sets: a role or permissions there were counted as yours in
    // every company (lib/membership.ts merges them in), `verified` is set by /api/verify/user/confirm,
    // and which company is yours by the join, create and remove-member routes. Writing them yourself
    // could make you owner or admin, skip verifying your email, or claim another company.
    function serverOnlyUserFields() {
      return [
        'role', 'roleId', 'permissions', 'permissionKeys', 'rolePermissions', 'grants',
        'permissionMap', 'rolePermissionsMap', 'grantsMap',
        'verified', 'verifiedAt', 'companyId', 'activeCompanyId', 'company'
      ];
    }

    // Each user keeps their own profile, apart from the fields above. (Sending one of them unchanged
    // is fine.)
    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid) && !request.resource.data.keys().hasAny(serverOnlyUserFields());
      allow update: if isSelf(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOnlyUserFields());
      allow delete: if false;

      // Per-user notification inbox (bell icon / Company Settings > Notifications). Reads and
      // read/unread updates are owner-only, but create is open to any signed-in user because a
      // teammate must be able to write a notification INTO someone else's inbox (e.g. "you were
      // assigned a project", "your role changed") — same trust level already used for appReports
      // and the legacy top-level /projects fallback below.
      match /notifications/{notificationId} {
        allow read: if isSelf(uid);
        allow create: if signedIn();
        allow update: if isSelf(uid);
        allow delete: if isSelf(uid);
      }

      // Saved checklist templates (User Settings > Create Checklist). Owner-only in every
      // direction — these are personal templates, never shared with teammates directly (a
      // project's own "checklists" field is what actually gets shared once one is added there).
      match /checklistTemplates/{templateId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid);
        allow update: if isSelf(uid);
        allow delete: if isSelf(uid);
      }
    }

    match /companies/{companyId} {
      allow read: if isCompanyMember(companyId);
      allow update: if canEditCompany(companyId) && !changesProtectedCompanyFields();
      // Created on the server, with its owner (lib/company-create-server.ts).
      allow create: if false;
      allow delete: if false;

      match /memberships/{uid} {
        allow read: if isSelf(uid) || isCompanyMember(companyId);

        // Joining and creating a company both happen on the server, which decides the role
        // (app/api/company/join, app/api/company/create). Writing your own membership here would let you
        // choose it.
        allow create: if false;

        // Your own: only your name, mobile, badge colour and What's New (onlyOwnMembershipFieldsOnUpdate).
        allow update: if isSelf(uid) && onlyOwnMembershipFieldsOnUpdate();
        allow delete: if false;
      }

      // Client records (Clients tab/CRM) — had no rule at all before this, which silently denied
      // every read/write to it (Firestore has no rule = deny, and rules never inherit to
      // subcollections — see companyStats' own comment on that). Includes the "__meta" doc written
      // right after a company is created (see onCreateCompany in
      // app/(staff)/company-onboarding/page.tsx), which is what originally surfaced this gap as a
      // permission-denied on company creation itself.
      match /clients/{clientId} {
        allow read, write: if isCompanyMember(companyId);
      }

      // Calendar tab events (lib/calendar-data.ts). Who may add/edit them is enforced in the app by
      // the role's calendar.view / calendar.edit permissions; at the rules level it's the same
      // company-member access as the company's other shared data.
      match /calendarEvents/{eventId} {
        allow read, write: if isCompanyMember(companyId);
      }

      // The completed-projects record (lib/completed-projects.ts — the Dashboard's Completed pop-up, for completion
      // bonuses): one doc per project, written as it's marked complete, stamped reopened / deleted, never removed —
      // so nobody can delete one here either. Same company-member access as the jobs themselves for the rest.
      match /completedProjects/{projectId} {
        allow read, create, update: if isCompanyMember(companyId);
        allow delete: if false;
      }

      // Leads (Leads page) — read straight from here so the page shows them quickly and stays live
      // (subscribeCompanyLeads in lib/firestore-data.ts). Same as /api/leads already gives any member:
      // which leads someone sees (all, or only their own) is the app's leads.view.others permission.
      // Every change still goes through /api/leads (lead forms, the email inbox, edits), never here.
      match /leads/{leadId} {
        allow read: if isCompanyMember(companyId);
        allow write: if false;
      }

      // Company Wrapped's per-year delta-tallied stats (doors/drawers/panels/materials/hinges).
      // Same access level as the parent company doc itself.
      match /companyStats/{year} {
        allow read, write: if isCompanyMember(companyId);

        // Sheets/edge-tape/lacquer m² aren't tallied on the parent doc above — each project
        // reports its own current-value snapshot here, summed together when Wrapped is viewed.
        // Firestore rules don't inherit to subcollections, so this needs its own explicit match.
        match /projectContributions/{projectId} {
          allow read, write: if isCompanyMember(companyId);
        }
      }

      match /jobs/{jobId} {
        allow read: if isCompanyMember(companyId);
        allow write: if isCompanyMember(companyId);

        // Quote grid / Specifications sheet version history — moved out of the job doc's own
        // `sales` field into their own subcollections (one small document per saved version)
        // so an ever-growing history no longer risks pushing the parent job doc past Firestore's
        // 1MB per-document limit. Same access level as the parent job doc itself.
        match /quoteGridVersions/{versionId} {
          allow read, write: if isCompanyMember(companyId);
        }
        match /specificationsVersions/{versionId} {
          allow read, write: if isCompanyMember(companyId);
        }
        // Product Compare tool's saved comparisons — same reasoning as the two subcollections
        // above (own small docs, same access level as the parent job doc).
        match /productComparisons/{comparisonId} {
          allow read, write: if isCompanyMember(companyId);
        }
        // Cutlist rows — same reasoning again: moved out of the job doc's own `cutlist`/
        // `cutlistJson` fields so opening a project no longer downloads the full cutlist, and a
        // single row edit no longer re-serializes every row on the project. "production"/
        // "initialMeasure" docs; same access level as the parent job doc.
        match /cutlistData/{kind} {
          allow read, write: if isCompanyMember(companyId);
        }
        // Checklists — one doc per checklist, moved out of the job doc's own `checklists` array
        // so toggling one checkbox no longer rewrites every checklist on the project.
        match /checklists/{checklistId} {
          allow read, write: if isCompanyMember(companyId);
        }
        // Sales — live Quote grid / Specifications grid, one doc per kind. Moved out of the job
        // doc's own `sales.quoteGrid`/`sales.specificationsGrid` fields — the heaviest payload
        // that used to be 4x-mirrored into the doc on every autosave.
        match /salesGrids/{kind} {
          allow read, write: if isCompanyMember(companyId);
        }
        // Images/files — one doc per kind, moved out of the job doc's own `projectImages`/
        // `projectImageItems`/`projectFiles` fields.
        match /projectMedia/{kind} {
          allow read, write: if isCompanyMember(companyId);
        }
        // Drawings — one doc per kind ("kitchen": Planning › Drawing).
        match /drawings/{kind} {
          allow read, write: if isCompanyMember(companyId);
        }
      }

      // Column automations' log (Company Settings › Automations): added to as they run, never changed.
      match /automationRuns/{runId} {
        allow read, create: if isCompanyMember(companyId);
        allow update, delete: if false;
      }

      // Invites: used by Staff & Permissions "Add Staff" and Join Company invite flow
      match /invites/{inviteId} {
        allow create, update: if isCompanyMember(companyId);
        allow read: if signedIn();
        allow delete: if isCompanyMember(companyId) || isInviteEmailMatch();
      }
    }

    // Optional legacy top-level projects fallback. Only members of the project's own company (or
    // whoever created it) can read or change one — it used to be any signed-in account, i.e. anyone
    // who registered could read every company's projects here. Looking up a project that isn't here
    // is still allowed (the app checks this location before the company's own jobs), and reading the
    // whole collection unfiltered is refused.
    function canUseLegacyProject(data) {
      return signedIn() &&
        (isCompanyMember(data.get("companyId", "")) || data.get("createdByUid", "") == request.auth.uid);
    }
    function canUseLegacyProjectChild(projectId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/projects/$(projectId)) &&
        canUseLegacyProject(get(/databases/$(database)/documents/projects/$(projectId)).data);
    }
    match /projects/{projectId} {
      allow read: if signedIn() && (resource == null || canUseLegacyProject(resource.data));
      // No new projects are made here any more (they all live in companies/{companyId}/jobs, and none are left here).
      // Making one could take over a client's link to another company's project.
      allow create: if false;
      allow update, delete: if canUseLegacyProject(resource.data);

      // Same version-history subcollections as companies/{companyId}/jobs/{jobId} above, for
      // projects still stored in this legacy top-level location — same access as the project.
      match /quoteGridVersions/{versionId} {
        allow read, write: if canUseLegacyProjectChild(projectId);
      }
      match /specificationsVersions/{versionId} {
        allow read, write: if canUseLegacyProjectChild(projectId);
      }
      match /productComparisons/{comparisonId} {
        allow read, write: if canUseLegacyProjectChild(projectId);
      }
      match /cutlistData/{kind} {
        allow read, write: if canUseLegacyProjectChild(projectId);
      }
      match /checklists/{checklistId} {
        allow read, write: if canUseLegacyProjectChild(projectId);
      }
      match /salesGrids/{kind} {
        allow read, write: if canUseLegacyProjectChild(projectId);
      }
      match /projectMedia/{kind} {
        allow read, write: if canUseLegacyProjectChild(projectId);
      }
      match /drawings/{kind} {
        allow read, write: if canUseLegacyProjectChild(projectId);
      }
    }
  }
}
